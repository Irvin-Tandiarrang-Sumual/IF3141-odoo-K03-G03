<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View Form Reservasi -->
    <record id="view_brocode_reservation_form" model="ir.ui.view">
        <field name="name">brocode.reservation.form</field>
        <field name="model">brocode.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="reservation_status" widget="statusbar" statusbar_visible="SelectingSlot,Confirmed,InService,Completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Data Utama">
                            <field name="customer_id"/>
                            <field name="service_name"/>
                            <field name="total_price"/>
                        </group>
                        <group string="Jadwal &amp; Penugasan">
                            <field name="barber_id"/>
                            <field name="branch_id"/>
                            <field name="service_time"/>
                        </group>
                    </group>
                </sheet>
                <!-- Area Audit Trail / Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- View Tree Reservasi -->
    <record id="view_brocode_reservation_tree" model="ir.ui.view">
        <field name="name">brocode.reservation.tree</field>
        <field name="model">brocode.reservation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="service_time"/>
                <field name="reservation_status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="action_brocode_reservation" model="ir.actions.act_window">
        <field name="name">Reservasi Layanan</field>
        <field name="res_model">brocode.reservation</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <!-- Action dummy untuk menu lain agar tidak error (Opsional untuk screenshot form lain) -->
    <record id="action_brocode_procurement" model="ir.actions.act_window">
        <field name="name">Pengadaan PO</field>
        <field name="res_model">brocode.procurement</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_brocode_expense" model="ir.actions.act_window">
        <field name="name">Klaim Biaya</field>
        <field name="res_model">brocode.expense</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>